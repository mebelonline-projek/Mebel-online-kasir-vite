# Karena Free akun klien sudah 2/2 project (website + monitoring):
# - Opsi B (disarankan): URL/key dari akun Supabase STAGING terpisah
# - Opsi C: URL/key dari project MONITORING yang sama dengan Next (hati-hati data produksi)

VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_or_publishable_key

# Opsional (Fase 3): Edge Function potong stok — deploy ke project yang sama dengan env di atas
# VITE_EDGE_APPLY_SALE_STOCK_URL=https://YOUR_PROJECT.supabase.co/functions/v1/apply-sale-stock
