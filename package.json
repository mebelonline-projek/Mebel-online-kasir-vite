    "@fontsource/playfair-display": "^5.3.0",
    "@hookform/resolvers": "^5.5.7",
    "@nosslabs/bluetooth-classic": "^1.2.0",
    "@react-pdf/renderer": "^4.5.1",
    "@supabase/supabase-js": "^2.110.9",
    "@tailwindcss/vite": "^4.3.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dexie": "^4.4.4",
